# Kopyalayın:  cp .env.example .env   (bu dosya git'e girmez)
# Kaynak: mock | tapo | 0 (bilgisayar kamerası) | rtsp://... | /yol/video.mp4
VIBESIGHT_SOURCE=mock

# Tapo C200 — Tapo uygulaması > Kamera > Ayarlar > Gelişmiş > Kamera Hesabı
VIBESIGHT_TAPO_HOST=192.168.1.50
VIBESIGHT_TAPO_USER=
VIBESIGHT_TAPO_PASSWORD=
# stream1 = 1080p (önerilen), stream2 = 360p (zayıf Wi-Fi için)
VIBESIGHT_TAPO_STREAM=stream1

VIBESIGHT_PRIVACY_BLUR=false
VIBESIGHT_ANALYSIS_HZ=6
